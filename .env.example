# A base URL including /v1, or the complete chat/completions URL.
ASTRA_LLM_BASE_URL=http://localhost:8000/v1
ASTRA_LLM_MODEL=your-model-id
# Leave empty for unauthenticated local servers. OPENAI_API_KEY is also accepted.
ASTRA_LLM_API_KEY=
# Optional independent reviewer; defaults to the same model.
# ASTRA_REVIEW_MODEL=your-review-model-id
# Minimal chat/messages requests work without tools or native structured output.
# ASTRA_LLM_JSON_MODE=true
# ASTRA_LLM_EXTRA_BODY={"max_tokens":8192,"temperature":0.1}
# ASTRA_LLM_EXTRA_HEADERS={"X-Custom-Header":"value"}

ASTRA_TIMEZONE=America/New_York
ASTRA_DATA_DIR=.astra
ASTRA_OUTPUT_DIR=output
# Used only as a read-only object source to accelerate the managed upstream clone.
ASTRA_FORGE_SEED=forge-1
# Optional token for higher GitHub API limits. Repository is always Card-Forge/forge.
# ASTRA_GITHUB_TOKEN=
ASTRA_POLL_SECONDS=21600
ASTRA_RELEASE_LOOKBACK_DAYS=30
# Optional narrow Scryfall query, e.g. set:abc (still filtered to paper English cards).
# ASTRA_SCRYFALL_QUERY=set:abc
# Maximum queued cards processed per invocation; remaining work stays queued.
ASTRA_MAX_CARDS=20

# Langfuse Cloud or a self-hosted Langfuse instance. Both keys enable tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://langfuse.example.com
# ASTRA_LANGFUSE_ENABLED=false
